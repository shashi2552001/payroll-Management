# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Optional initial Admin bootstrap password (if unset, use the first-run setup UI)
ADMIN_BOOTSTRAP_PASSWORD=

# Database & Private Storage (must remain outside /public and /dist)
DB_PATH=
PRIVATE_STORAGE_DIR=

# Real SMTP Email Delivery Configuration (Nodemailer)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="9HR India HR <hr@9hrindia.com>"
SUPPORT_EMAIL="hr-support@9hrindia.com"

# Optional ClamAV Malware Scanner TCP Daemon
CLAMAV_HOST=
CLAMAV_PORT=3310

# Configurable Security Defaults
CANDIDATE_LINK_EXPIRY_HOURS=72
MAX_UPLOAD_SIZE_MB=5
